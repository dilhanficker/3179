  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "score",
              "as": "min_score"
            },
            {
              "op": "max",
              "field": "score",
              "as": "max_score"
            }
          ],
          "groupby": [
            "dimension"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#E5E7EB"
      },
      "encoding": {
        "y": {
          "field": "dimension",
          "type": "nominal",
          "axis": {
            "title": null,
            "labelColor": "#374151",
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "min_score",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Readiness score (0\u2013100)",
            "labelColor": "#6B7280",
            "gridColor": "#F3F4F6"
          }
        },
        "x2": {
          "field": "max_score"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "dimension",
          "type": "nominal"
        },
        "x": {
          "field": "score",
          "type": "quantitative"
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australia",
              "USA",
              "UK",
              "Singapore"
            ],
            "range": [
              "#F59E0B",
              "#2563EB",
              "#10B981",
              "#7C3AED"
            ]
          },
          "legend": {
            "title": null,
            "labelFontSize": 12,
            "labelColor": "#374151"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "dimension",
            "type": "nominal",
            "title": "Dimension"
          },
          {
            "field": "score",
            "type": "quantitative",
            "title": "Score"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "DM Sans, sans-serif"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}