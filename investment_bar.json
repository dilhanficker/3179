  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "x": {
      "field": "country",
      "type": "nominal",
      "sort": "-y",
      "axis": {
        "title": null,
        "labelAngle": -30,
        "labelColor": "#374151",
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "investment",
      "type": "quantitative",
      "axis": {
        "title": "Private investment (USD billions)",
        "labelColor": "#6B7280",
        "gridColor": "#F3F4F6"
      }
    },
    "color": {
      "condition": {
        "test": "datum.highlight === true",
        "value": "#F59E0B"
      },
      "value": "#2563EB"
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "investment",
        "type": "quantitative",
        "title": "Investment (USD B)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "DM Sans, sans-serif"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}