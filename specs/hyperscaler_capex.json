{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Global hyperscaler AI capital expenditure 2022-2026 (USD billions) - Goldman Sachs Equity Research 2025",
  "width": "container",
  "height": 240,
  "data": {
    "values": [
      {"year": "2022", "capex": 68,  "forecast": false},
      {"year": "2023", "capex": 110, "forecast": false},
      {"year": "2024", "capex": 222, "forecast": false},
      {"year": "2025", "capex": 320, "forecast": false},
      {"year": "2026", "capex": 430, "forecast": true}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {"title": null, "labelColor": "#374151", "labelFontSize": 13}
    },
    "y": {
      "field": "capex",
      "type": "quantitative",
      "axis": {"title": "Capex (USD billions)", "labelColor": "#6B7280", "gridColor": "#F3F4F6"}
    },
    "color": {
      "condition": {"test": "datum.forecast === true", "value": "#93C5FD"},
      "value": "#2563EB"
    },
    "opacity": {
      "condition": {"test": "datum.forecast === true", "value": 0.6},
      "value": 1
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "capex", "type": "quantitative", "title": "Capex (USD B)", "format": ","},
      {"field": "forecast", "type": "nominal", "title": "Forecast?"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {"stroke": null},
    "font": "DM Sans, sans-serif"
  }
}
