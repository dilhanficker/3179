{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian enterprise AI adoption rate 2017-2024 with event annotations",
  "width": "container",
  "height": 280,
  "data": {
    "values": [
      {"year": 2017, "adoption": 22, "label": null},
      {"year": 2018, "adoption": 29, "label": null},
      {"year": 2019, "adoption": 34, "label": null},
      {"year": 2020, "adoption": 38, "label": null},
      {"year": 2021, "adoption": 46, "label": null},
      {"year": 2022, "adoption": 55, "label": null},
      {"year": 2023, "adoption": 67, "label": null},
      {"year": 2024, "adoption": 77, "label": null}
    ]
  },
  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.15, "color": "#2563EB"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative", "axis": {"format": "d", "title": null, "labelColor": "#6B7280", "gridColor": "#F3F4F6"}},
        "y": {"field": "adoption", "type": "quantitative", "axis": {"title": "Adoption rate (%)", "labelColor": "#6B7280", "gridColor": "#F3F4F6", "format": "d"}, "scale": {"domain": [0, 100]}}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "color": "#2563EB"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "adoption", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 60, "color": "#2563EB"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "adoption", "type": "quantitative"},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "adoption", "type": "quantitative", "title": "Adoption rate (%)", "format": "d"}
        ]
      }
    },
    {
      "data": {"values": [{"year": 2020}]},
      "mark": {"type": "rule", "strokeDash": [4, 3], "color": "#EF4444", "strokeWidth": 1.5},
      "encoding": {"x": {"field": "year", "type": "quantitative"}}
    },
    {
      "data": {"values": [{"year": 2020, "label": "COVID-19", "adoption": 88}]},
      "mark": {"type": "text", "align": "left", "dx": 6, "dy": 0, "fontSize": 11, "color": "#EF4444", "fontWeight": "500"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "adoption", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"year": 2022}]},
      "mark": {"type": "rule", "strokeDash": [4, 3], "color": "#F59E0B", "strokeWidth": 1.5},
      "encoding": {"x": {"field": "year", "type": "quantitative"}}
    },
    {
      "data": {"values": [{"year": 2022, "label": "ChatGPT launch", "adoption": 88}]},
      "mark": {"type": "text", "align": "left", "dx": 6, "dy": 0, "fontSize": 11, "color": "#F59E0B", "fontWeight": "500"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "adoption", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": null},
    "font": "DM Sans, sans-serif"
  }
}
